# syntax=docker/dockerfile:1.7
# Development image: the toolchain, every tool `just` calls, and air for hot reload. Deliberately NOT
# multi-stage and NOT the production image — it needs a compiler and a writable source tree, which
# production must never have. Source is bind-mounted by compose; nothing here copies it.
#
# This is also the image CI's checks mirror, which is what stops "passes locally, fails in CI". The
# tool versions below are pinned in .github/workflows/{{ cookiecutter.component }}-ci.yml too — bump them together.
# Ask Athena for the containerization rules.

ARG GO_VERSION={{ cookiecutter.go_version }}
ARG GOLANGCI_LINT_VERSION=v2.15.0
ARG SQLC_VERSION=1.31.1

# Official images, used only as a source of static binaries. sqlc's needs cgo to build, so it is
# copied rather than installed with `go install`.
FROM golangci/golangci-lint:${GOLANGCI_LINT_VERSION} AS golangci-lint
FROM sqlc/sqlc:${SQLC_VERSION} AS sqlc

FROM golang:${GO_VERSION}-bookworm

ARG SWAG_VERSION=v1.16.6
ARG GOOSE_VERSION=v3.29.0
ARG GOVULNCHECK_VERSION=v1.9.0
ARG AIR_VERSION=v1.67.4

# psql, for `just shell` against the local database.
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends postgresql-client \
    && rm -rf /var/lib/apt/lists/*

# goose's build tags drop the drivers for databases this service does not use; without them it
# compiles SQLite, MySQL, ClickHouse and four more into a tool that only ever creates a file.
RUN --mount=type=cache,target=/root/.cache/go-build \
    --mount=type=cache,target=/go/pkg/mod \
    go install github.com/swaggo/swag/cmd/swag@${SWAG_VERSION} \
    && go install -tags='no_clickhouse no_libsql no_mssql no_mysql no_sqlite3 no_vertica no_ydb' \
        github.com/pressly/goose/v3/cmd/goose@${GOOSE_VERSION} \
    && go install golang.org/x/vuln/cmd/govulncheck@${GOVULNCHECK_VERSION} \
    && go install github.com/air-verse/air@${AIR_VERSION}

COPY --from=golangci-lint /usr/bin/golangci-lint /usr/local/bin/golangci-lint
COPY --from=sqlc /workspace/sqlc /usr/local/bin/sqlc

WORKDIR /app
# -buildvcs=false: the repository's .git is not mounted — only backend/ is — so Go cannot stamp VCS
# information into a build, and says so on every `go build` unless told not to try.
# -tags=nomsgpack: gin's MessagePack binding, which this API never speaks. Without the tag every
# build compiles ugorji/go/codec — the largest package in the graph, enough to exhaust a 2 GB Docker
# VM under the race detector — and ships an unused decoder. The production image, CI and
# .golangci.yml build with the same tag; keep them in step.
ENV GOFLAGS="-buildvcs=false -tags=nomsgpack"

EXPOSE 8000
# Compose replaces this command for `dev-runner` and the CI test runner; for `backend` it is the dev
# server: air rebuilds and restarts the binary on every save. See .air.toml.
CMD ["air", "-c", ".air.toml"]
