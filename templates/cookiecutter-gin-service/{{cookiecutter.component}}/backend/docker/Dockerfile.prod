# syntax=docker/dockerfile:1.7
# Production image. Build context is backend/. Ask Athena for the containerization rules.
#
# Five things here are load-bearing and easy to break:
#   1. go.mod and go.sum are copied BEFORE the source, so editing a .go file reuses the cached
#      module-download layer. Reversing those COPY lines re-downloads every dependency on every build.
#   2. -mod=readonly: the build fails on a go.mod that disagrees with go.sum rather than resolving
#      something new. go.sum is committed (run `just lock` once after generating the project).
#   3. CGO_ENABLED=0 produces a static binary, which is what lets the runtime stage be distroless
#      `static` — no libc, no shell, no package manager. -trimpath keeps the builder's paths out of
#      the binary and its panics. -tags=nomsgpack drops gin's MessagePack codec, which this API
#      never speaks (see Dockerfile.dev).
#   4. The runtime stage starts from distroless, NOT from the builder: inheriting it would ship a Go
#      toolchain, a compiler and ~800 MB of attack surface to production.
#   5. The builder runs on the BUILD machine's platform and cross-compiles for the target one
#      (--platform=$BUILDPLATFORM, GOOS/GOARCH from TARGETOS/TARGETARCH). The image is linux/amd64,
#      and `just infra-first-deploy` builds it on whatever laptop runs it: without this, an
#      Apple-silicon machine runs the whole Go toolchain under QEMU, several times slower. Go
#      cross-compiles a CGO-free binary natively, and the runtime stage — which is the target
#      platform — only copies it.
#
# Base images are referenced by tag. Pin them by digest (`image@sha256:...`) before you rely on
# this in production, and let your dependency bot move the digest, so a rebuild cannot silently pick
# up a different base.

ARG GO_VERSION={{ cookiecutter.go_version }}

# --- builder --------------------------------------------------------------
FROM --platform=$BUILDPLATFORM golang:${GO_VERSION}-bookworm AS builder
# Set by BuildKit from --platform; declared so the RUN below can read them.
ARG TARGETOS TARGETARCH
WORKDIR /src
COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod \
    go mod download && go mod verify
COPY . .
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH go build -mod=readonly -trimpath -tags=nomsgpack -ldflags='-s -w' -o /out/api ./cmd/api

# --- production: the binary and nothing else ------------------------------
FROM gcr.io/distroless/static-debian12:nonroot AS production

COPY --from=builder /out/api /app/api

# The immutable build SHA, so /health/ready can say which revision is answering and Sentry can
# attribute a regression to a commit.
ARG GIT_SHA=""
ENV GIT_SHA=${GIT_SHA} \
    PORT=8080 \
    JSON_LOGS=true

# Distroless's nonroot user (65532). Spelled out so `docker inspect` says so, and a base-image
# change cannot quietly make it root.
USER nonroot:nonroot
EXPOSE 8080

# No curl in this image, by design: the binary probes itself. Cloud Run ignores HEALTHCHECK and uses
# its own probes on /health/live; this is for `docker run` and Compose.
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
    CMD ["/app/api", "healthcheck"]

# ENTRYPOINT is the binary and CMD its default subcommand, so `docker run <image> migrate up` works
# and the migrate job (command ["/app/api"], args ["migrate", "up"]) runs this same image. The binary
# is PID 1 and receives SIGTERM directly — there is no shell to swallow it — which is what lets
# `api serve` drain in-flight requests on a revision swap.
ENTRYPOINT ["/app/api"]
CMD ["serve"]
