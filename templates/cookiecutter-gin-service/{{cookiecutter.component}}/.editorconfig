root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# gofmt indents with tabs and is the only formatter Go code answers to.
[{*.go,go.mod}]
indent_style = tab

[*.{json,yml,yaml,sql,toml,md}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
