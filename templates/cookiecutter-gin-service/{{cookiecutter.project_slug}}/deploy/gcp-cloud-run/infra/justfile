# Infrastructure recipes. The root justfile delegates `infra-*` here; `just` in this directory runs
# them directly.
#
# Unlike backend/, these run on the host, not in a container. A Pulumi Go program is compiled by
# the Go toolchain on the machine running `pulumi`, and `pulumi`, `gcloud` and `gh` all act with
# your own credentials — mounting those into a container would be more machinery and more places
# for a credential to land. So `go`, `pulumi` and `golangci-lint` are host prerequisites for this
# directory and nothing else: infra/README.md lists them, and `_require` says which one is missing.
{% raw %}
set shell := ["bash", "-euo", "pipefail", "-c"]

# Show available recipes
default:
    @just --list

# Resolve go.sum. It is not templated, so this is the first command after generating — commit what it writes
lock: (_require "go")
    cd pulumi && go mod tidy

# Unit-test the stack against mocks. No cloud credentials needed.
test *ARGS: (_require "go")
    cd pulumi && go test ./... {{ARGS}}

# Vet and lint the stack
lint: (_require "go") (_require "golangci-lint")
    cd pulumi && go vet ./... && golangci-lint run ./...

# --refresh on preview, up and destroy is load-bearing, not hygiene. CD updates the Cloud Run image
# out of band; without a refresh, Pulumi's state still holds the previous image, ignore_changes has
# nothing to preserve, and the next apply rolls the service back to it.

# Show what `pulumi up` would change
preview STACK="dev" *FLAGS: (_require "go") (_require "pulumi")
    cd pulumi && pulumi preview --stack {{STACK}} --refresh --diff {{FLAGS}}

# `pulumi up` asks for confirmation and refuses to run at all when nothing can answer:
# "--yes must be passed in to proceed when running in non-interactive mode". That is the right
# behaviour for the one command here that creates billable resources, so this recipe does not pass
# --yes for you; it passes your flags through instead, and a pipeline or an agent types the word.
# The stack name is positional, so the flag has to come after one.
#
# Creates real, billable resources — read the preview first. Unattended: `just up dev --yes`
up STACK="dev" *FLAGS: (_require "go") (_require "pulumi")
    cd pulumi && pulumi up --stack {{STACK}} --refresh {{FLAGS}}

{% endraw %}{% if cookiecutter.use_postgres == "yes" %}{% raw %}
# The signing key and the database admin password are never in the program, its configuration or
# its state (Pulumi standards MUST-3, ADR-0023). The stack creates their containers empty; this
# generates each value, pipes it into Secret Manager, and records the version for the stack to pin.
# Run it after the first `up`, then `up` again. Prints no value and writes no file.

# Generate the signing key and the database admin password. `--rotate` replaces them, signing everyone out
secrets STACK="dev" *FLAGS: (_require "pulumi") (_require "gcloud") (_require "openssl") (_require "curl") (_require "python3")
    ./scripts/secrets.sh {{STACK}} {{FLAGS}}
{% endraw %}{% endif %}{% raw %}
# Copy stack outputs into GitHub repository variables, which un-gates cd.yml. Refuses until secrets_ready
sync-github STACK="dev": (_require "pulumi") (_require "gh")
    ./scripts/sync-github.sh {{STACK}}

# Destroying is two commands, not one, and they are not interchangeable. `pulumi destroy` removes
# what the stack created. It cannot remove the bucket its own state lives in or the KMS key that
# encrypts that state, because the stack never created them — the bootstrap script did. Run them
# in this order; the teardown script enforces it rather than trusting you to remember.

# Destroy everything the stack created. Prompts, for the same reason `up` does.
destroy STACK="dev" *FLAGS: (_require "go") (_require "pulumi")
    cd pulumi && pulumi destroy --stack {{STACK}} --refresh {{FLAGS}}

# Delete the state bucket and KMS key, which `destroy` cannot. Refuses unless every stack is empty
teardown: (_require "pulumi") (_require "gcloud")
    ./bootstrap/teardown.sh

[private]
_require TOOL:
    @command -v {{TOOL}} >/dev/null || { echo "{{TOOL}} is not installed. infra/ recipes run on the host — see infra/README.md." >&2; exit 1; }
{% endraw %}
