{
  "project_name": "Example Service",
  "project_slug": "{{ cookiecutter.project_name.lower().replace(' ', '-').replace('_', '-') }}",
  "description": "A Gin service built to the Engineering Athena handbook.",
  "author": "Your Name",
  "go_module": "github.com/your-org/{{ cookiecutter.project_slug }}",
  "go_version": "1.27",
  "deploy_target": ["gcp-cloud-run", "aws-ecs-express"],
  "gcp_project_id": "your-gcp-project",
  "gcp_region": "europe-west1",
  "aws_account_id": "123456789012",
  "aws_region": "eu-west-1",
  "github_repository": "your-org/{{ cookiecutter.project_slug }}",
  "use_postgres": ["yes", "no"],
  "use_sentry": ["yes", "no"],
  "_copy_without_render": [
    ".github/workflows/*",
    "deploy/*/workflows/*"
  ],
  "__prompts__": {
    "deploy_target": {
      "__prompt__": "Where it deploys",
      "gcp-cloud-run": "GCP: Cloud Run + Cloud SQL",
      "aws-ecs-express": "AWS: ECS Express Mode + RDS"
    },
    "gcp_project_id": "GCP project id (gcp-cloud-run only)",
    "gcp_region": "GCP region (gcp-cloud-run only)",
    "aws_account_id": "AWS account id, 12 digits (aws-ecs-express only)",
    "aws_region": "AWS region (aws-ecs-express only)"
  }
}
