# Copy to .env for local development. `.env` is gitignored and MUST stay that way.
#
# This file is **one of three** places configuration lives, and nothing moves between them:
#
#   1. here, for your machine — never committed, and every value below is safe to read aloud;
{% if cookiecutter.deploy_target == "aws-ecs-express" %}#   2. GitHub repository *variables*, for the deploy pipeline — AWS_DEPLOY_ROLE_ARN, AWS_REGION,
#      IMAGE_REPO, ECS_CLUSTER, ECS_SERVICE_ARN, SERVICE_URL and the rest. `just infra-sync-github`{% else %}#   2. GitHub repository *variables*, for the deploy pipeline — WIF_PROVIDER, DEPLOY_SA,
#      GCP_REGION, IMAGE_REPO, CLOUD_RUN_SERVICE, CLOUD_RUN_MIGRATE_JOB. `just infra-sync-github`{% endif %}
#      sets them from the stack's outputs; do not type them by hand;
{% if cookiecutter.deploy_target == "aws-ecs-express" %}#   3. Secrets Manager, for anything the deployed service must not have in a file. Those arrive as
#      environment variables on the ECS task and appear nowhere in this repository.{% else %}#   3. Secret Manager, for anything the deployed service must not have in a file. Those arrive as
#      environment variables on the Cloud Run revision and appear nowhere in this repository.{% endif %}
#
# A deployed value never comes from a file. Ask Athena for the secrets-management rules.
#
# This file lives at the repository root because Docker Compose lives here and the stack shares it:
# the same POSTGRES_* values configure the `db` container and the backend that connects to it.

ENVIRONMENT=local
LOG_LEVEL=INFO
# Human-readable locally; JSON everywhere a log aggregator reads it.
JSON_LOGS=false
GIT_SHA=local

# --- Browser client ---
# Origins a browser client may call this API from, comma-separated — e.g. a dev server on
# http://localhost:3000, which is where an app generated from cookiecutter-react-app runs. Empty
# means no cross-origin access at all, which is right until a web client exists.
CORS_ORIGINS=
{% if cookiecutter.use_postgres == "yes" %}
# --- Database (these values configure both the db container and the backend) ---
# How the backend proves who it is to Postgres. `password` here, in tests and in CI, and for the
# deployed migration {% if cookiecutter.deploy_target == "aws-ecs-express" %}task{% else %}job{% endif %}. The deployed service uses {% if cookiecutter.deploy_target == "aws-ecs-express" %}`rds-iam` — a token signed with the ECS task
# role for every new connection, from DATABASE_HOST, DATABASE_PORT, DATABASE_NAME, DATABASE_USER
# and AWS_REGION{% else %}`cloud-sql-iam` — the Cloud SQL connector, logging in
# as the revision's service account, from CLOUD_SQL_INSTANCE, DATABASE_NAME and DATABASE_USER{% endif %} — and
# holds no password at all. The stack sets those; nothing here needs to.
DATABASE_AUTH=password
#
# In `password` mode the DSN comes from the first of these that is set:
#   1. DATABASE_URL_OVERRIDE, used whole;
#   2. DATABASE_HOST, DATABASE_PORT (5432 if unset), DATABASE_NAME, DATABASE_USER and
#      DATABASE_PASSWORD — all of them, once DATABASE_HOST is set; a DATABASE_HOST starting with
#      `/` is a Unix socket directory;
#   3. the POSTGRES_* values below, which the Postgres container reads too.
# TLS for a DSN built from parts is the driver's: asyncpg honours PGSSLMODE, as libpq does.
POSTGRES_HOST=db
POSTGRES_PORT=5432
# The port Postgres is published on *your machine*, which is the only setting here that can
# collide with something outside this project. Change it if 55432 is taken.
POSTGRES_HOST_PORT=55432
POSTGRES_USER={{ cookiecutter.project_slug.replace('-', '_') }}
POSTGRES_PASSWORD=local-only-not-a-secret
POSTGRES_DB={{ cookiecutter.project_slug.replace('-', '_') }}

# --- Authentication ---
# The HS256 key access tokens are signed with. Left unset on purpose: locally the code falls back
# to a sentinel, and a deployed server refuses to start with that sentinel or with anything under
# 32 characters. {% if cookiecutter.deploy_target == "aws-ecs-express" %}Deployed, the value comes from Secrets Manager{% else %}Deployed, the value comes from Secret Manager{% endif %} — `just infra-secrets` generates
# it and adds it there without printing it, and the stack mounts the pinned version. Nobody types it.
#
# Set one here if you would rather your local tokens were not signed with a key that is printed
# in this template:
#   openssl rand -base64 48
# JWT_SECRET=
#
# Where the refresh token travels. `body` (the default) returns it in the JSON body and takes it
# back the same way — right for server-to-server and mobile clients. A browser client uses `cookie`:
# an httpOnly cookie no script can read, which needs CORS_ORIGINS set to the client's origin.
REFRESH_TRANSPORT=body
# The cookie is marked `Secure` everywhere but here: the API answers on plain http://localhost, and a
# browser that refuses a Secure cookie over HTTP would sign you out on every reload. A deployed
# server refuses to start with this set to false. Only read when REFRESH_TRANSPORT=cookie.
REFRESH_COOKIE_SECURE=false
{% endif %}{% if cookiecutter.use_sentry == "yes" %}
# --- Observability ---
# MUST stay empty locally: developer machines must not report into a real Sentry project.
{% if cookiecutter.deploy_target == "aws-ecs-express" %}# Deployed, this comes from a Secrets Manager secret the stack creates empty — put the real DSN
# in with `aws secretsmanager put-secret-value`, then set `sentryDsnVersion` in
# infra/pulumi/Pulumi.dev.yaml to the VersionId it prints.{% else %}# Deployed, this comes from a Secret Manager container the stack creates empty — put the real DSN
# in with `gcloud secrets versions add`, then set `sentryDsnVersion` in infra/pulumi/Pulumi.dev.yaml.{% endif %}
# Ask Athena for the Sentry error-tracking rules.
SENTRY_DSN=
{% endif %}
