# Root orchestrator. Recipe names are identical in every repository — an engineer or agent should
# never have to read a justfile to know how to run the tests.
# Ask Athena for the local development and command runner rules.
#
# This justfile owns the things that span components (the stack, CI's gate) and DELEGATES
# everything language-specific to backend/justfile and frontend/justfile. Another component is
# another delegation line — the command vocabulary here never grows.
{% raw %}
set shell := ["bash", "-uc"]

compose := "docker compose"
ci      := "docker compose -f docker-compose.ci.yml"
backend := "just --justfile backend/justfile --working-directory backend"
{% endraw %}{% if cookiecutter.include_frontend == "yes" %}{% raw %}frontend := "just --justfile frontend/justfile --working-directory frontend"
{% endraw %}{% endif %}{% raw %}
# `just` defaults the working directory to the justfile's own directory, so backend recipes run
# from backend/ exactly as they would if you cd'd there. Stated explicitly rather than inherited.

# Show available recipes
default:
    @just --list

# --- The stack -----------------------------------------------------------

# Start the full local stack with hot reload
dev: _env
    {{compose}} up --build

# Stop the stack and remove volumes
down:
    {{compose}} down -v
    -{{ci}} down -v

# Tail logs for a service (default: backend)
logs SERVICE="backend":
    {{compose}} logs -f {{SERVICE}}

# Open a shell in the backend container
shell: _env
    {{compose}} run --rm dev-runner bash

# Create .env on first run. `just dev` from a clean clone must not need a manual step.
# Every recipe that reaches docker compose depends on this, because compose reads the root `.env`
# and a freshly generated project does not have one. Without it `just check` — the first command
# anybody runs on a new project — fails on a missing env file rather than on anything about their
# code, which is the worst possible first impression of a template.
_env:
    @test -f .env || (cp .env.example .env && echo "created .env from .env.example")

# --- Quality -------------------------------------------------------------

# Everything CI runs, in CI's order. If this passes, the pipeline passes.
check: _env lint test

# Lint, format check, type check and layer contracts, for every component
lint: _env
    {{backend}} lint
{% endraw %}{% if cookiecutter.include_frontend == "yes" %}{% raw %}    {{frontend}} lint
{% endraw %}{% endif %}{% raw %}

# Apply formatting and safe autofixes, for every component
fmt: _env
    {{backend}} fmt
{% endraw %}{% if cookiecutter.include_frontend == "yes" %}{% raw %}    {{frontend}} fmt
{% endraw %}{% endif %}{% raw %}

# Run the full test suite in parallel. ARGS reach the backend suite; the frontend's runs whole,
# because pytest node ids and vitest file paths are not the same vocabulary. Target a single
# frontend test with `cd frontend && just test-one <file>`.
test *ARGS: _env
    {{backend}} test {{ARGS}}
{% endraw %}{% if cookiecutter.include_frontend == "yes" %}{% raw %}    {{frontend}} test
{% endraw %}{% endif %}{% raw %}

# Run one test file or node, verbose and fail-fast
test-one TARGET:
    {{backend}} test-one {{TARGET}}

# Dependency vulnerability scan
audit: _env
    {{backend}} audit
{% endraw %}{% if cookiecutter.include_frontend == "yes" %}{% raw %}
# --- API client ----------------------------------------------------------

# Regenerate the frontend's typed API client from the backend's OpenAPI document.
# Run it in the SAME change as the backend edit that motivated it — a client regenerated later
# is a client that was wrong in between. The stack must be up (`just dev` in another terminal).
gen-api: _env
    {{frontend}} gen-api
{% endraw %}{% endif %}{% raw %}

# --- Database ------------------------------------------------------------
{% endraw %}{% if cookiecutter.use_postgres == "yes" %}{% raw %}
# Apply all migrations
db-migrate: _env
    {{backend}} db-migrate

# Create a new revision from model changes
db-revision MESSAGE: _env
    {{backend}} db-revision "{{MESSAGE}}"

# Roll back one revision
db-rollback: _env
    {{backend}} db-rollback

# Compare the models against the local database
db-check: _env
    {{backend}} db-check

# Verify a single linear migration history. No database needed — this is the one CI runs
db-heads: _env
    {{backend}} db-heads

# Drop and recreate the local database, then migrate
db-reset: _env
    {{compose}} down -v db
    {{compose}} up -d db
    @until {{compose}} exec -T db pg_isready >/dev/null 2>&1; do sleep 1; done
    just db-migrate
{% endraw %}{% endif %}{% raw %}
# --- Build ---------------------------------------------------------------

# Build the production images
build:
    {{backend}} build
{% endraw %}{% if cookiecutter.include_frontend == "yes" %}{% raw %}    {{frontend}} build
{% endraw %}{% endif %}{% raw %}

# --- Infrastructure ------------------------------------------------------
#
# Separate from `check` on purpose. `check` is the gate for application code and runs in Docker;
# the stack has its own toolchain, its own workflow and its own gate, and pulling it into `check`
# would make every backend change wait on a Pulumi install.

# Unit-test the Pulumi components. No cloud credentials needed.
infra-test:
    cd infra/pulumi && uv run pytest -q

# Lint and type-check the stack
infra-lint:
    cd infra/pulumi && uv run ruff check . && uv run ruff format --check . && uv run mypy .

# --refresh on the next two recipes is load-bearing, not hygiene. CD updates the Cloud Run image
# out of band; without a refresh, Pulumi's state still holds the previous image, ignore_changes has
# nothing to preserve, and the next apply rolls the service back to it.

# Show what `pulumi up` would change
infra-preview STACK="dev" *FLAGS:
    cd infra/pulumi && uv run pulumi preview --stack {{STACK}} --refresh --diff {{FLAGS}}

# `pulumi up` asks for confirmation and refuses to run at all when nothing can answer:
# "--yes must be passed in to proceed when running in non-interactive mode". That is the right
# behaviour for the one command here that creates billable resources, so this recipe does not pass
# --yes for you; it passes your flags through instead, and a pipeline or an agent types the word.
# The stack name is positional, so the flag has to come after one.
#
# Creates real, billable resources — read the preview first. Unattended: `just infra-up dev --yes`
infra-up STACK="dev" *FLAGS:
    cd infra/pulumi && uv run pulumi up --stack {{STACK}} --refresh {{FLAGS}}

# Copy stack outputs into GitHub repository variables, which un-gates cd.yml
infra-sync-github STACK="dev":
    ./infra/scripts/sync-github.sh {{STACK}}

# Destroying is two commands, not one, and they are not interchangeable. `pulumi destroy` removes
# what the stack created. It cannot remove the bucket its own state lives in or the KMS key that
# encrypts that state, because the stack never created them — the bootstrap script did. Run them
# in this order; the teardown script enforces it rather than trusting you to remember.

# Destroy everything the stack created. Prompts, for the same reason `infra-up` does.
infra-destroy STACK="dev" *FLAGS:
    cd infra/pulumi && uv run pulumi destroy --stack {{STACK}} --refresh {{FLAGS}}

# Delete the state bucket and KMS key, which `destroy` cannot. Refuses unless every stack is empty
infra-teardown:
    ./infra/bootstrap/teardown.sh
{% endraw %}
