# syntax=docker/dockerfile:1.7
# Development image. Deliberately NOT multi-stage: it needs the toolchain, the dev dependency
# group and a writable source tree. Source is bind-mounted by compose.
# Ask Athena for the containerization rules.

ARG PYTHON_VERSION={{ cookiecutter.python_version }}
FROM python:${PYTHON_VERSION}-slim-bookworm

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PROJECT_ENVIRONMENT=/opt/venv \
    PATH="/opt/venv/bin:$PATH"

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends \
        build-essential curl git libpq-dev postgresql-client \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:0.8.11 /uv /usr/local/bin/uv
WORKDIR /app
# The venv lives outside /app so a bind mount over /app cannot hide it.
COPY pyproject.toml uv.lock ./
RUN --mount=type=cache,target=/root/.cache/uv uv sync --frozen

COPY app/ ./app/

EXPOSE 8000
# Inline, unlike the production image's `docker/start.sh`. There is nothing here for a script to
# protect: exec form already makes uvicorn PID 1, the port is fixed and matches the EXPOSE above
# and compose's mapping, and the line is the canonical uvicorn invocation rather than something a
# reader has to reconstruct. Compose replaces this command outright for `dev-runner` and for the
# CI test runner, so a script would be an indirection with one caller.
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--reload"]
