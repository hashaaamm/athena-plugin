# Copy to .env for local development. `.env` is gitignored and MUST stay that way.
#
# This file is **one of three** places configuration lives, and nothing moves between them:
#
#   1. here, for your machine — never committed, and every value below is safe to read aloud;
#   2. GitHub repository *variables*, for the deploy pipeline — WIF_PROVIDER, DEPLOY_SA,
#      GCP_REGION, IMAGE_REPO, CLOUD_RUN_SERVICE, CLOUD_RUN_MIGRATE_JOB. `just infra-sync-github`
#      sets them from the stack's outputs; do not type them by hand;
#   3. Secret Manager, for anything the deployed service must not have in a file. Those arrive as
#      environment variables on the Cloud Run revision and appear nowhere in this repository.
#
# A deployed value never comes from a file. Ask Athena for the secrets-management rules.
#
# This file lives at the repository root because Docker Compose lives here and the stack shares it:
# the same POSTGRES_* values configure the `db` container and the backend that connects to it.

ENVIRONMENT=local
LOG_LEVEL=INFO
# Human-readable locally; JSON everywhere a log aggregator reads it.
JSON_LOGS=false
GIT_SHA=local
{% if cookiecutter.use_postgres == "yes" %}
# --- Database (these values configure both the db container and the backend) ---
POSTGRES_HOST=db
POSTGRES_PORT=5432
# The port Postgres is published on *your machine*, which is the only setting here that can
# collide with something outside this project. Change it if 55432 is taken.
POSTGRES_HOST_PORT=55432
POSTGRES_USER={{ cookiecutter.project_slug.replace('-', '_') }}
POSTGRES_PASSWORD=local-only-not-a-secret
POSTGRES_DB={{ cookiecutter.project_slug.replace('-', '_') }}
{% endif %}{% if cookiecutter.use_sentry == "yes" %}
# --- Observability ---
# MUST stay empty locally: developer machines must not report into a real Sentry project.
# Deployed, this comes from a Secret Manager container the stack creates empty — put the real DSN
# in with `gcloud secrets versions add`, then set `sentryDsnSet` in infra/pulumi/Pulumi.dev.yaml.
# Ask Athena for the Sentry error-tracking rules.
SENTRY_DSN=
{% endif %}
