# Frontend configuration. Copy to .env.local for development — Vite reads .env.local and it is
# gitignored. The root .env.example carries the same values for the Compose stack; this file is
# what you need when you run `pnpm dev` on your own machine instead.
#
# Vite exposes ONLY variables prefixed VITE_ to client code, as `import.meta.env.VITE_*`, and it
# inlines them at BUILD time. Two consequences, both of which have bitten people:
#
#   1. Nothing here is a secret. Every value below ships to the browser in plain text.
#      An API key in this file is a published API key. Ask Athena for the secrets-management rules.
#   2. Changing one on a deployed container does nothing. They are baked into the bundle, so they
#      are Docker build args (see docker/Dockerfile.prod), not Cloud Run environment variables.

# Base URL of the backend API.
VITE_API_URL=http://localhost:8000

# The OpenAPI document `pnpm gen:api` reads to regenerate src/lib/api/schema.d.ts.
# FastAPI serves it at /openapi.json — and not at all in production, by design.
VITE_API_SCHEMA_URL=http://localhost:8000/openapi.json
