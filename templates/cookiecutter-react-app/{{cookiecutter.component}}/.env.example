# Copy to .env for local development — `just dev` does it for you on the first run. `.env` is
# gitignored and MUST stay that way. Compose passes it to the dev-server container, and Vite reads
# the same file when you run `pnpm dev` on your own machine instead.
#
# Vite exposes ONLY variables prefixed VITE_ to client code, as `import.meta.env.VITE_*`, and it
# inlines them at BUILD time. Two consequences, both of which have bitten people:
#
#   1. Nothing here is a secret. Every value below ships to the browser in plain text.
#      An API key in this file is a published API key. Ask Athena for the secrets-management rules.
#   2. Changing one where the app is deployed does nothing. They are baked into the bundle. CD
#      compiles in the `{{ cookiecutter.__component_var }}_API_URL` repository variable, which
#      `just infra-sync-github` copies from the stack's `api_url` — `/`, the site's own origin,
#      while the site serves the API — infra/README.md has the step.

# Base URL of the backend API: an absolute address, or `/` for the page's own origin. The browser
# makes these requests, so this is the address as your machine sees it. The backend has to allow
# this app's origin: its CORS_ORIGINS must include http://localhost:3000.
VITE_API_URL={{ cookiecutter.api_url }}

# The OpenAPI document `just gen-api` reads to regenerate src/lib/api/schema.d.ts. The backend
# serves it at /openapi.json — and not at all when it runs with ENVIRONMENT=production, by design.
# `localhost` here is rewritten to host.docker.internal when the command runs in the container.
VITE_API_SCHEMA_URL={{ cookiecutter.api_url }}/openapi.json

# The host port the dev server is published on. The only value here that can collide with
# something outside this project.
APP_HOST_PORT=3000
