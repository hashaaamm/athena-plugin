# Infrastructure recipes. The component's justfile delegates `infra-*` here; `just` in this directory runs
# them directly.
#
# Unlike the application's recipes, these run on the host, not in a container. Pulumi runs the
# TypeScript program with the Node and the node_modules on the machine running `pulumi`, and
# `pulumi`, `gcloud` and `gh` all act with your own credentials — mounting those into a container
# would be more machinery and more places for a credential to land. So `node`, `pnpm` and `pulumi`
# are host prerequisites for this directory and nothing else: infra/README.md lists them, and
# `_require` says which one is missing.
{% raw %}
set shell := ["bash", "-euo", "pipefail", "-c"]

# Show available recipes
default:
    @just --list

# Resolve pnpm-lock.yaml. It is not templated, so this is the first command after generating — commit what it writes
lock: (_require "pnpm")
    cd pulumi && pnpm install --lockfile-only

# Install the stack's dependencies exactly as locked. Every recipe below that runs code needs them
install: (_require "pnpm")
    cd pulumi && pnpm install --frozen-lockfile

# Unit-test the stack against Pulumi's mocks. No cloud credentials needed.
test *ARGS: install
    cd pulumi && pnpm exec vitest run {{ARGS}}

# Type-check and lint the stack
lint: install
    cd pulumi && pnpm exec tsc --noEmit && pnpm exec eslint .

# --refresh on preview, up and destroy is load-bearing, not hygiene. CD updates the Cloud Run
# service's image out of band; without a refresh, Pulumi's state still holds the previous image,
# ignoreChanges has nothing to preserve, and the next apply rolls the site back to it.

# Show what `pulumi up` would change
preview STACK="dev" *FLAGS: install (_require "pulumi")
    cd pulumi && pulumi preview --stack {{STACK}} --refresh --diff {{FLAGS}}

# `pulumi up` asks for confirmation and refuses to run at all when nothing can answer:
# "--yes must be passed in to proceed when running in non-interactive mode". That is the right
# behaviour for the one command here that creates billable resources, so this recipe does not pass
# --yes for you; it passes your flags through instead, and a pipeline or an agent types the word.
# The stack name is positional, so the flag has to come after one.
#
# Creates real, billable resources — read the preview first. Unattended: `just up dev --yes`
up STACK="dev" *FLAGS: install (_require "pulumi")
    cd pulumi && pulumi up --stack {{STACK}} --refresh {{FLAGS}}

# The first deploy, from this machine: build the real image for linux/amd64, push it, and create
# the Cloud Run service on it with `pulumi up --refresh`, which asks for confirmation as `up` does.
# Unattended: `just first-deploy dev --yes`
first-deploy STACK="dev" *FLAGS: install (_require "pulumi") (_require "gcloud") (_require "docker") (_require "git") (_require "curl")
    ./scripts/first-deploy.sh {{STACK}} {{FLAGS}}

# Copy stack outputs into GitHub repository variables, which un-gates the component's CD workflow
sync-github STACK="dev": (_require "pulumi") (_require "gh")
    ./scripts/sync-github.sh {{STACK}}

# Destroying is two commands, not one, and they are not interchangeable. `pulumi destroy` removes
# what the stack created. It cannot remove the bucket its own state lives in or the KMS key that
# encrypts that state, because the stack never created them — the bootstrap script did. Run them in this order; the teardown script enforces it rather
# than trusting you to remember.

# Destroy everything the stack created. Prompts, for the same reason `up` does.
destroy STACK="dev" *FLAGS: install (_require "pulumi")
    cd pulumi && pulumi destroy --stack {{STACK}} --refresh {{FLAGS}}

# Delete the state bucket and KMS key, which `destroy` cannot. Refuses unless every stack is empty
teardown: install (_require "pulumi") (_require "gcloud")
    ./bootstrap/teardown.sh

[private]
_require TOOL:
    @command -v {{TOOL}} >/dev/null || { echo "{{TOOL}} is not installed. infra/ recipes run on the host — see infra/README.md." >&2; exit 1; }
{% endraw %}
