# The entry point an engineer and an agent both reach for. Recipe names are identical in every
# repository — nobody should have to read a justfile to know how to run the tests. Ask Athena for
# the local development and command runner rules.
#
# This is a `just` module of the repository's root justfile, so every recipe runs the same two ways:
# `just check` from this folder, and `just {{ cookiecutter.component }} check` from the root. Either
# way it runs in this folder — just runs a module's recipes in the module's directory — so nothing
# here may depend on where it was invoked from.
#
# The application's recipes run in the compose `app` container: the toolchain that runs here is the
# toolchain CI runs, and none of it needs Node installed on your machine. If you would rather use
# your own Node, `pnpm lint` and friends work the same from this directory — package.json's scripts
# are the single definition, and these recipes only choose where they run.
#
# The infrastructure's recipes run on the host, and are delegated to infra/justfile — see there.
{% raw %}
set shell := ["bash", "-uc"]

compose := "docker compose"
run     := "docker compose run --rm --no-deps app sh -c"
infra   := "just --justfile infra/justfile --working-directory infra"

# `docker compose run` REPLACES the service's command, so the `corepack enable` in
# docker-compose.yml does not happen for any recipe here. node:24-slim ships corepack but puts no
# pnpm on PATH until it is enabled, so every recipe enables it first — and gets the exact pnpm
# pinned in package.json's `packageManager` field rather than whatever is newest.
corepack := "corepack enable"

# Dependencies are a named volume, not a bind mount, so a fresh clone has none. Every recipe
# installs first; with the volume warm that is a no-op that costs about a second.
deps := corepack + " && pnpm install --frozen-lockfile"

# Show available recipes
default:
    @just --list

# Compose refuses to start a service whose `env_file:` is missing, so every recipe that reaches
# Docker depends on this. It is what makes `just lock` work on a clone nobody has set up yet, which
# matters because that command is the first one in a new project.
_env:
    @test -f .env || (cp .env.example .env && echo "created .env from .env.example")

# --- Local development ---------------------------------------------------

# Run the Vite dev server on http://localhost:3000, against VITE_API_URL in .env
dev: _env
    {{compose}} up

# Stop the dev server and remove its node_modules volume
down:
    {{compose}} down -v

# Tail the dev server's logs
logs: _env
    {{compose}} logs -f app

# Open a shell in the app container
shell: _env
    {{compose}} run --rm --no-deps app bash

# --- Quality -------------------------------------------------------------

# Everything CI runs, in CI's order: lint, types, tests, the production bundle. If this passes, the
# pipeline passes. The dependency audit is `just audit`, separately, because it asks the registry.
check: lint test build

# Lint and type check
lint: _env
    {{run}} "{{deps}} && pnpm lint && pnpm typecheck"

# Apply safe autofixes. There is no separate formatter in this stack — ESLint owns it.
fmt: _env
    {{run}} "{{deps}} && pnpm exec eslint . --fix"

# Run the test suite
test *ARGS: _env
    {{run}} "{{deps}} && pnpm exec vitest run {{ARGS}}"

# Run one test file, watching
test-one TARGET: _env
    {{compose}} run --rm --no-deps --service-ports app sh -c "{{deps}} && pnpm exec vitest {{TARGET}}"

# Build the production bundle into dist/. A build that only ever runs at deploy time is a build
# that breaks at deploy time.
build: _env
    {{run}} "{{deps}} && pnpm build"

# Dependency vulnerability scan: fails on a high or critical advisory, as CI does
audit: _env
    {{run}} "{{deps}} && pnpm audit --audit-level high"

# --- Dependencies --------------------------------------------------------

# Resolve pnpm-lock.yaml: run once after generating, and after any dependency edit.
# The lockfile is not templated — a committed one would pin whatever existed when the template
# was last touched. Every install uses --frozen-lockfile, so a stale one fails loudly.
lock: _env
    {{run}} "{{corepack}} && pnpm install --lockfile-only"

# --- API client ----------------------------------------------------------

# Regenerate src/lib/api/schema.d.ts from the backend's OpenAPI document, VITE_API_SCHEMA_URL.
# Run it on EVERY backend API change, with the backend up. It runs in the container, where
# `localhost` is the container itself, so a localhost URL is rewritten to the host's address.
gen-api: _env
    {{run}} '{{deps}} && VITE_API_SCHEMA_URL="$(printf %s "$VITE_API_SCHEMA_URL" | sed -E "s#//(localhost|127[.]0[.]0[.]1)([:/]|$)#//host.docker.internal\2#")" pnpm gen:api'
{% endraw %}{% if cookiecutter.deploy_target == "gcp-cloud-run" %}{% raw %}
# Build the production image. VITE_* values are inlined at build time, so they are build args.
image:
    DOCKER_BUILDKIT=1 docker build \
        --platform=linux/amd64 \
        -f docker/Dockerfile.prod \
        --target production \
        --build-arg VITE_API_URL="${VITE_API_URL:-$(sed -n 's/^VITE_API_URL=//p' .env.example)}" \
        -t "{{env_var_or_default('IMAGE_REPO', 'local')}}/$(basename "$PWD"):$(git rev-parse --short HEAD)" \
        .
{% endraw %}{% endif %}{% raw %}
# --- Infrastructure ------------------------------------------------------
#
# Separate from `check` on purpose. `check` is the gate for the application and runs in Docker;
# the stack has its own toolchain, its own workflow and its own gate, and pulling it into `check`
# would make every component change wait on a Pulumi install. infra/justfile has the reasoning
# behind each guard.

# Unit-test the stack against Pulumi's mocks. No cloud credentials needed.
infra-test:
    {{infra}} test

# Type-check and lint the stack
infra-lint:
    {{infra}} lint

# Show what `pulumi up` would change
infra-preview STACK="dev" *FLAGS:
    {{infra}} preview {{STACK}} {{FLAGS}}

# Creates real, billable resources — read the preview first. Unattended: `just infra-up dev --yes`
infra-up STACK="dev" *FLAGS:
    {{infra}} up {{STACK}} {{FLAGS}}

# The first deploy, from this machine: {% endraw %}{% if cookiecutter.deploy_target == "gcp-cloud-run" %}build and push the image, create the service on it{% else %}build the bundle, publish it{% endif %}{% raw %}, smoke-test. Unattended: `just infra-first-deploy dev --yes`
infra-first-deploy STACK="dev" *FLAGS:
    {{infra}} first-deploy {{STACK}} {{FLAGS}}

# Copy stack outputs into GitHub repository variables, which un-gates the deploy workflows
infra-sync-github STACK="dev":
    {{infra}} sync-github {{STACK}}

# Destroy everything the stack created. Prompts, for the same reason `infra-up` does.
infra-destroy STACK="dev" *FLAGS:
    {{infra}} destroy {{STACK}} {{FLAGS}}

# Delete the state backend, which `destroy` cannot. Refuses unless every stack is empty
infra-teardown:
    {{infra}} teardown
{% endraw %}
